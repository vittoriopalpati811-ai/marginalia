<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Watch-app entitlements: the watch app and its complication extension share a
  watch-side App Group container so the app can persist the WatchConnectivity
  snapshot and the complications can read it.

  Requires the "App Groups" capability to be enabled on the
  io.marginalia.app.watchkitapp App ID (and the group registered in the portal).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.marginalia.watch</string>
	</array>
</dict>
</plist>
