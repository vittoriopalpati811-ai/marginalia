<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Committed (like Info.plist) so flutter create preserves it. Wired into the
  Runner target via a perl patch in codemagic.yaml (CODE_SIGN_ENTITLEMENTS).
  aps-environment = production: TestFlight/App Store builds use the PRODUCTION
  APNs environment, which matches the APNs auth key + send-push-notification
  (api.push.apple.com).
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!--
	  Sign in with Apple. REQUIRED for the native ASAuthorizationAppleIDProvider
	  sheet: without this entitlement the sheet never appears and the only way in
	  is Apple's web page, which renders blank inside the in-app browser (the
	  Guideline 2.1(a) rejection of 2026-09-01). The matching capability is
	  enabled on App ID io.marginalia.app, grouped under the primary
	  io.marginalia.signin so the Apple user id matches the web Service ID.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.marginalia.widget</string>
	</array>
</dict>
</plist>
