<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Marginalia — iOS app metadata.

  This file is committed BEFORE running `flutter create`, so the
  command will see it exists and leave it alone. After
  `flutter create --platforms=ios --org io.marginalia .` runs, the
  rest of the iOS scaffold (Runner.xcodeproj, AppDelegate.swift,
  Assets.xcassets, etc.) will be generated alongside this file.

  Required additions over Flutter's default template:
    * NSPhotoLibraryUsageDescription — file_picker reads photos for
      avatar / cover / chat image selection.
    * Bundle identifier hard-coded to io.marginalia.app (matches
      codemagic.yaml ios_signing.bundle_identifier).
    * CADisableMinimumFrameDurationOnPhone = true to allow 120Hz
      rendering on ProMotion iPhones.
    * UIApplicationSupportsIndirectInputEvents required by Flutter
      for trackpad/mouse events.

  NOT included (add later if/when the feature ships):
    * NSCameraUsageDescription — only needed when barcode scanner
      ships (task #26 had it deferred to native-only).
    * NSHealthShareUsageDescription / NSHealthUpdateUsageDescription
      — health_service is stubbed; not wired to the `health` package.
    * NSLocationWhenInUseUsageDescription — weather uses IP-based
      geolocation, no GPS permission needed.
    * CFBundleURLTypes for OAuth callbacks — add when Google /
      Sign in with Apple are enabled on Supabase.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Marginalia</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>marginalia</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!--
	  CRITICAL — do NOT remove. Names the storyboard iOS loads as the app's
	  MAIN interface; that storyboard instantiates the FlutterViewController
	  which starts the engine and runs Dart. `flutter create` generates
	  Main.storyboard, but this hand-written Info.plist originally omitted this
	  key, so iOS launched with NO root view controller: a black window, no
	  crash, and Dart never ran. THAT was the real cause of the TestFlight black
	  screen — every Dart-side fix (render-first bootstrap, Impeller off) and
	  even a zero-dependency magenta test build (#5) still showed pure black,
	  because the Flutter engine was never started in the first place.
	-->
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!--
	  Force the legacy Skia renderer instead of Impeller.

	  Impeller is the DEFAULT iOS renderer in Flutter 3.22 and is a known
	  cause of release-only (TestFlight/App Store, NOT debug) black screens
	  on real devices — most often on shaders and BackdropFilter blur, which
	  this app uses heavily in the frosted "liquid glass" bottom nav bar.
	  The founder reported a fully black launch on TestFlight twice; after
	  ruling out a thrown exception (the BootstrapErrorApp screen never
	  appeared) and restructuring main() to paint a splash before any async
	  init (so a startup HANG can no longer black-screen), an Impeller engine
	  failure remained the other plausible cause. Skia is the battle-tested
	  pre-3.x renderer and Flutter's officially documented fallback for
	  Impeller-specific rendering bugs.

	  If the app launches correctly with this set, Impeller can be re-enabled
	  later (delete this key) once the specific failing effect is isolated —
	  Skia costs some ProMotion smoothness but guarantees a visible frame.
	-->
	<key>FLTEnableImpeller</key>
	<false/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Marginalia needs access to your photo library so you can pick an avatar, a profile cover, or attach an image to a chat message.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Marginalia reads today's calendar events on-device to tailor your daily reading highlight to your day. This data never leaves your phone.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Marginalia reads today's calendar events on-device to tailor your daily reading highlight to your day. This data never leaves your phone.</string>
	<!--
	  Export-compliance declaration. Marginalia uses only Apple's stock
	  HTTPS/TLS (Supabase, the `http` package) — i.e. standard encryption
	  that is EXEMPT from US export rules. Declaring this here auto-answers
	  the "Missing Compliance" question in TestFlight/App Store Connect, so
	  every uploaded build is immediately installable by testers instead of
	  blocking on a manual cryptography prompt. (Without it, build #8 sat in
	  "Missing Compliance".) If real non-exempt crypto is ever added, remove
	  this key and answer the questionnaire in App Store Connect instead.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
