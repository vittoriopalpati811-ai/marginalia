# ─── Flutter / Dart ──────────────────────────
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart
*.freezed.dart
pubspec.lock
lib/generated/

# ─── Flutter per-platform — ios/ is TRACKED (Codemagic builds from it).
#     The desktop platforms are still ignored — we don't ship to them.
linux/
macos/
windows/
# web/ NON ignorato: contiene index.html e manifest.json scritti a mano

# ─── iOS — committed scaffold, but generated artifacts excluded ─────
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*
# leftover Swift project from pre-Flutter era (inline comments aren't valid in .gitignore)
ios/Sources/

# ─── Android — ignored entirely until we ship Android ───────────────
android/

# ─── Supabase ────────────────────────────────
supabase/.temp/

# ─── Python / scripts ────────────────────────
scripts/__pycache__/
scripts/*.pyc
scripts/.env
scripts/venv/
scripts/.venv/

# ─── IDE / editor ────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Secrets ─────────────────────────────────
.env
.env.local
*.p12
*.pem
*.key
*.mobileprovision
# App Store Connect API private key (AuthKey_XXXXXXXXXX.p8) — uploaded to
# Codemagic for signing, must never land in git.
*.p8
AuthKey_*.p8

