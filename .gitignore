# ─── macOS ───────────────────────────────────
.DS_Store
.AppleDouble

# ─── Windows ─────────────────────────────────
Thumbs.db
Desktop.ini

# ─── Flutter / Dart ──────────────────────────
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart
*.freezed.dart
# pubspec.lock IS committed (this is an app, not a library): pins exact
# transitive versions for reproducible builds + supply-chain integrity.
lib/generated/

# ─── Flutter per-platform — ios/ is TRACKED (Codemagic builds from it).
#     The desktop platforms are still ignored — we don't ship to them.
linux/
macos/
windows/
# web/ NON ignorato: contiene index.html e manifest.json scritti a mano

# ─── iOS — committed scaffold, but generated artifacts excluded ─────
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*
# leftover Swift project from pre-Flutter era (inline comments aren't valid in .gitignore)
ios/Sources/

# ─── Android — source is TRACKED now (cyber-sec hardening + build config
#     committed; android/ is the build source for the APK). Only build
#     artefacts, the machine-local SDK path, IDE files, the generated plugin
#     registrant, and any signing keystore stay out of git.
android/.gradle/
android/.cxx/
android/captures/
android/**/local.properties
android/**/GeneratedPluginRegistrant.java
android/**/*.iml
key.properties
*.jks
*.keystore

# ─── Supabase ────────────────────────────────
supabase/.temp/

# ─── Python / scripts ────────────────────────
scripts/__pycache__/
scripts/*.pyc
scripts/.env
scripts/venv/
scripts/.venv/
# Codemagic helper scripts live in the repo root and embed a live API token —
# NEVER commit them (a `git add -A` would otherwise stage the token).
cm_*.py

# ─── IDE / editor ────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Secrets ─────────────────────────────────
.env
.env.local
.env.*
!.env.example
*.p12
*.pem
*.key
*.cer
*.mobileprovision
# Firebase config plists embed an API key — never commit if Firebase is added.
GoogleService-Info.plist
android/app/google-services.json
# App Store Connect API private key (AuthKey_XXXXXXXXXX.p8) — uploaded to
# Codemagic for signing, must never land in git.
*.p8
AuthKey_*.p8

# ─── Docs / local artefacts (never in the public repo) ──
*.pdf

# ─── Claude Code locale ──────────────────────
.claude/cache/
.claude/sessions/

# The admin console's URL path. Rotated 2026-08-25 because the old one had
# been sitting in three commits of PUBLIC history — an obscurity layer that is
# published is not one. Never commit this.
.console-slug

# wrangler's local state - never useful in git
.wrangler/
